# Pentagon Quest UI – route everything through path-handler.php
# Document root = this project folder (named "Pentagon Quest UI" on AMPPS/XAMPP)

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Uncomment if rewrites fail in a subfolder install:
  # RewriteBase "/Pentagon Quest UI/"

  # Never expose backend / tooling
  RewriteRule ^(?:apps|scripts|_old_scaffold|\.git)(?:/|$) - [F,L]

  # Let the handler and existing root files run as-is
  RewriteRule ^path-handler\.php(?:/.*)?$ - [L]

  # If the request already maps to a real file/dir at project root, keep it
  # (except we still want /admin /devs etc. to go through the handler when
  # those are only empty rewrite stubs)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Send everything else into /public via the path handler
  RewriteRule ^(.*)$ path-handler.php [QSA,L]
</IfModule>

DirectoryIndex index.php path-handler.php public/index.html

<IfModule mod_authz_core.c>
  <If "%{REQUEST_URI} =~ m#/(apps|scripts|_old_scaffold)(/|$)#">
    Require all denied
  </If>
</IfModule>
