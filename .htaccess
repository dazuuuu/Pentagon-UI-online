# Pentagon Quest UI – route everything through path-handler.php
# Document root = this project folder (named "Pentagon Quest UI" on AMPPS/XAMPP)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /Pentagon%20Quest%20UI/

  # Never expose backend / tooling
  RewriteRule ^(?:apps|scripts|_old_scaffold|\.git)(?:/|$) - [F,L]

  # Let the handler (and PATH_INFO) run as-is
  RewriteRule ^path-handler\.php(?:/.*)?$ - [L]

  # Existing root PHP proxies (admin/*.php, devs/*.php, …) run directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Everything else (static pages, CSS under public/, pretty URLs) → handler
  RewriteRule ^(.*)$ path-handler.php [QSA,L]
</IfModule>

DirectoryIndex index.php path-handler.php public/index.html

<IfModule mod_authz_core.c>
  <If "%{REQUEST_URI} =~ m#/(apps|scripts|_old_scaffold)(/|$)#">
    Require all denied
  </If>
</IfModule>
