# Copy this file to .env (same folder) and fill in real values.
# .env is already in .gitignore — never commit real credentials.

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pentagon_quest
DB_USER=root
DB_PASS=

# --- SMTP (Admin -> SMTP Settings in the dashboard overrides these) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@pentagonquest.com
SMTP_FROM_NAME=Pentagon Quest
